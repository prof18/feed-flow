-- feed_search matched rows by url_hash, an ordinary FTS4 column. FTS4 tables cannot carry
-- secondary indexes, so every feed_item delete scanned the entire index: clearing 5k items
-- out of 20k took ~14s locally, long enough for iOS to suspend the app mid-transaction and
-- kill it for holding a lock on the app-group container (0xdead10cc).
-- Rebuild the index keyed on docid, which aliases the indexed rowid.
DROP TRIGGER IF EXISTS populate_feed_search;
DROP TRIGGER IF EXISTS delete_feed_search;
DROP TABLE IF EXISTS feed_search;

CREATE VIRTUAL TABLE feed_search USING FTS4(
    url_hash TEXT NOT NULL,
    title TEXT,
    subtitle TEXT,
    tokenize=unicode61 "tokenchars=+#"
);

CREATE TRIGGER populate_feed_search
AFTER INSERT ON feed_item
BEGIN INSERT OR IGNORE INTO feed_search(docid, url_hash, title, subtitle) VALUES (new.rowid, new.url_hash, new.title, new.subtitle);
END;

CREATE TRIGGER delete_feed_search
BEFORE DELETE ON feed_item
BEGIN DELETE FROM feed_search WHERE docid = old.rowid;
END;

INSERT OR IGNORE INTO feed_search(docid, url_hash, title, subtitle)
SELECT rowid, url_hash, title, subtitle
FROM feed_item;
